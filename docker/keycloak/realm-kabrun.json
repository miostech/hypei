{
  "realm": "kabrun",
  "displayName": "Kabrun",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "passwordPolicy": "length(10) and notUsername and notEmail and passwordHistory(3)",
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@kabrun.local",
    "fromDisplayName": "Kabrun",
    "ssl": "false",
    "starttls": "false",
    "auth": "false"
  },
  "loginTheme": "kabrun",
  "internationalizationEnabled": true,
  "supportedLocales": ["pt-BR", "en", "es", "fr", "de", "it"],
  "defaultLocale": "pt-BR",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "platform_admin",
        "description": "Kabrun staff with access to /admin. Authorization is still enforced by Kabrun."
      }
    ]
  },
  "clients": [
    {
      "clientId": "kabrun-web",
      "name": "Kabrun Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "kabrun-web-local-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3000/api/auth/callback", "http://localhost:3100/api/auth/callback"],
      "webOrigins": ["http://localhost:3000", "http://localhost:3100"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##http://localhost:3100/*"
      }
    }
  ],
  "users": [
    {
      "username": "producer@kabrun.dev",
      "email": "producer@kabrun.dev",
      "firstName": "Produtora",
      "lastName": "Demo",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "kabrun-dev-123", "temporary": false }]
    },
    {
      "username": "admin@kabrun.dev",
      "email": "admin@kabrun.dev",
      "firstName": "Admin",
      "lastName": "Kabrun",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": ["default-roles-kabrun", "platform_admin"],
      "credentials": [{ "type": "password", "value": "kabrun-dev-123", "temporary": false }]
    }
  ]
}
