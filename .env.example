# ─────────────────────────────────────────────────────────────
# Hypei — environment variables
# Copy to `.env` for local development. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# development | staging | production
APP_ENV=development
APP_URL=http://localhost:3100

# Session cookie signing secret (min 32 chars). Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-with-32-plus-chars
# Keyed hash used for tax identity deduplication (min 32 chars).
DATA_HASH_SECRET=change-me-to-another-long-random-string-32-plus

# PostgreSQL — system of record (commerce + finance)
DATABASE_URL=postgresql://hypei:hypei@localhost:5432/hypei?schema=public
# Used only by integration tests
TEST_DATABASE_URL=postgresql://hypei:hypei@localhost:5432/hypei_test?schema=public

# MongoDB — flexible/document/event data
MONGODB_URI=mongodb://localhost:27017/hypei
MONGODB_DB=hypei

# Redis — cache / queue / locks
REDIS_URL=redis://localhost:6379

# Keycloak — identity (realm: hypei, client: hypei-web)
KEYCLOAK_URL=http://localhost:8080
# Optional: server-to-server URL when the app runs in a container (e.g. http://keycloak:8080)
KEYCLOAK_INTERNAL_URL=
KEYCLOAK_REALM=hypei
KEYCLOAK_CLIENT_ID=hypei-web
KEYCLOAK_CLIENT_SECRET=hypei-web-local-dev-secret

# Payments — stripe | mock
PAYMENT_PROVIDER=mock
# Stripe (TEST MODE keys only during development: sk_test_… / pk_test_…)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_API_VERSION=
# Mock provider: webhook signing secret + simulated processor fee (basis points)
MOCK_WEBHOOK_SECRET=mock-webhook-local-dev-secret
MOCK_PROCESSOR_FEE_BPS=400

# Storage — s3 | r2 | minio | none
STORAGE_PROVIDER=none
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Email — console | resend | ses | postmark
EMAIL_PROVIDER=console
EMAIL_FROM=Hypei <no-reply@hypei.local>

# Queue — memory | bullmq | redis-streams
QUEUE_DRIVER=memory

LOG_LEVEL=info
