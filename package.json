{
  "name": "ripay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "worker": "tsx --conditions=react-server src/workers/index.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:demo": "tsx --conditions=react-server scripts/seed-demo.ts",
    "db:studio": "prisma studio",
    "mongo:setup": "tsx scripts/mongo-setup.ts",
    "settlement:run": "tsx --conditions=react-server scripts/run-settlement.ts",
    "settlement:simulate": "tsx --conditions=react-server scripts/run-settlement.ts --simulate",
    "check:infra": "tsx scripts/check-infra.ts",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/webhooks/stripe"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@stripe/react-stripe-js": "^6.11.0",
    "@stripe/stripe-js": "^9.17.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.47.0",
    "mongodb": "^7.6.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "stripe": "^22.6.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.1",
    "dotenv": "^18.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
